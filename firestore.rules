rules_version = '2';

// Reglas de seguridad para TradeX (Firestore)
// Pegar este contenido en: Firebase Console -> Firestore Database -> Reglas

service cloud.firestore {
  match /databases/{database}/documents {

    // Directorio de empresas: público para leer (así funciona el directorio
    // sin necesidad de estar logueado), pero cada empresa solo puede crear
    // o modificar SU PROPIO documento (el id del documento = su uid de Auth).
    //
    // El campo "plan" (y los demás de adminFields) NO se puede escribir
    // desde el cliente: nace en "gratis" y solo lo cambia la Cloud Function
    // del webhook de Mercado Pago cuando el cobro se aprueba, o el equipo a
    // mano desde Firebase Console. Así nadie se autoasigna un plan pago
    // haciendo updateDoc desde la consola del navegador. "verificada" igual:
    // nace en false y la pone en true el equipo después de revisar la
    // documentación de la empresa.
    // Campos que maneja solo el equipo de TradeX o las Cloud Functions
    // (que usan permisos de administrador y no pasan por estas reglas).
    function adminFields(){
      return ['plan', 'verificada', 'planSince', 'planBilling', 'planUntil',
              'mpPreapprovalId', 'claimedBy', 'verificacionPagada'];
    }
    function paidPlans(){
      return ['destacado', 'porcotizacion', 'enterprise', 'pro'];
    }
    function myCompany(){
      return get(/databases/$(database)/documents/companies/$(request.auth.uid)).data;
    }
    function iAmPaid(){
      return request.auth != null && myCompany().get('plan', 'gratis') in paidPlans();
    }

    match /companies/{companyId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == companyId
                    && request.resource.data.plan == "gratis"
                    && request.resource.data.verificada == false
                    && !request.resource.data.keys().hasAny(['planSince', 'planBilling', 'planUntil', 'mpPreapprovalId', 'claimedBy', 'verificacionPagada']);
      // diff().affectedKeys() cubre campos agregados, cambiados y borrados,
      // y no falla con documentos viejos que no tienen esos campos.
      allow update: if request.auth != null
                    && request.auth.uid == companyId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminFields());
      allow delete: if false;

      // Datos de contacto. Los puede leer:
      //  - la propia empresa;
      //  - cualquier cuenta con plan pago;
      //  - cualquier empresa compradora, si esta ficha es de un proveedor
      //    Destacado (es lo que paga el Destacado).
      match /private/contact {
        allow read: if request.auth != null
                    && (request.auth.uid == companyId
                        || iAmPaid()
                        || (get(/databases/$(database)/documents/companies/$(companyId)).data.get('plan', 'gratis') == 'destacado'
                            && myCompany().get('accountType', 'empresa') == 'empresa'));
        allow write: if request.auth != null && request.auth.uid == companyId;
      }

      // Reportes mensuales que genera la Cloud Function: solo los lee el dueño.
      match /reports/{reportId} {
        allow read: if request.auth != null && request.auth.uid == companyId;
        allow write: if false;
      }
    }

    // Feed de publicaciones: público para leer, pero solo un usuario logueado
    // puede publicar, y únicamente a nombre de sí mismo (authorId == su uid).
    // No se permite editar ni borrar posteos desde el cliente.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Me gusta: un documento por combinación posteo+usuario, con el id
    // "<postId>__<uid>" — así Firestore mismo evita que alguien tenga más
    // de un Me gusta en el mismo posteo. Cada usuario solo puede crear/borrar
    // el suyo propio.
    match /postLikes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && likeId == request.resource.data.postId + '__' + request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Comentarios: público para leer, solo un usuario logueado puede
    // comentar y únicamente a nombre de sí mismo. No se permite editar
    // ni borrar comentarios desde el cliente.
    match /postComments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Requerimientos (RFQs): público para leer (así se ven las
    // "Oportunidades" sin estar logueado), solo un usuario logueado puede
    // publicar uno y únicamente a nombre de sí mismo (buyerId == su uid).
    // No se permite editar ni borrar desde el cliente.
    match /rfqs/{rfqId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.get('quotes', 0) == 0;
      // La única actualización permitida es sumar 1 al contador de
      // cotizaciones, en el mismo batch en que esa empresa crea su
      // cotización (y solo si no había cotizado antes).
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quotes'])
                    && request.resource.data.quotes == resource.data.get('quotes', 0) + 1
                    && existsAfter(/databases/$(database)/documents/quotes/$(rfqId + '__' + request.auth.uid))
                    && !exists(/databases/$(database)/documents/quotes/$(rfqId + '__' + request.auth.uid));
      allow delete: if false;
    }

    // Cotizaciones: una por proveedor y requerimiento (id "<rfqId>__<uid>").
    // Las ve solo quien cotizó y la empresa que publicó el requerimiento.
    // Nota: el tope de 3 cotizaciones por mes del plan Gratis se controla
    // en la app; las reglas no pueden contar documentos.
    match /quotes/{quoteId} {
      allow read: if request.auth != null
                  && (resource.data.supplierId == request.auth.uid
                      || resource.data.buyerId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.supplierId == request.auth.uid
                    && quoteId == request.resource.data.rfqId + '__' + request.auth.uid
                    && request.resource.data.buyerId == get(/databases/$(database)/documents/rfqs/$(request.resource.data.rfqId)).data.buyerId
                    && request.resource.data.buyerId != request.auth.uid
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() <= 2000
                    && request.resource.data.precio is string
                    && request.resource.data.precio.size() <= 120;
      allow update, delete: if false;
    }

    // Vistas de perfil y de contacto (métricas del panel y la garantía).
    // Un documento por empresa vista + empresa que mira + mes. Solo el
    // dueño de la ficha las puede leer.
    match /profileViews/{viewId} {
      allow read: if request.auth != null && resource.data.companyId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.viewerId == request.auth.uid
                    && request.resource.data.companyId != request.auth.uid
                    && viewId == request.resource.data.companyId + '__' + request.auth.uid + '__' + request.resource.data.month;
      allow update, delete: if false;
    }
    match /contactViews/{viewId} {
      allow read: if request.auth != null && resource.data.companyId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.viewerId == request.auth.uid
                    && request.resource.data.companyId != request.auth.uid
                    && viewId == request.resource.data.companyId + '__' + request.auth.uid + '__' + request.resource.data.month;
      allow update, delete: if false;
    }

    // Pedidos de plan / add-ons mientras no esté activo el cobro automático.
    // Los crea la empresa logueada; el equipo los ve desde la consola.
    match /planRequests/{reqId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pendiente';
      allow update, delete: if false;
    }

    // "Reclamá tu perfil": pedidos que el equipo revisa a mano.
    match /claims/{claimId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pendiente'
                    && request.resource.data.companyId is string;
      allow update, delete: if false;
    }

    // Licitaciones públicas: las carga el equipo con
    // scripts/cargar-licitaciones.mjs. Cualquiera ve la muestra
    // (preview == true); el listado completo es para planes pagos.
    match /licitaciones/{licId} {
      allow read: if resource.data.get('preview', false) == true || iAmPaid();
      allow write: if false;
    }
    match /stats/{statId} {
      allow read: if true;
      allow write: if false;
    }

    // Registro de errores del cliente (monitoreo básico, sin Sentry ni
    // servicios de pago): cualquiera puede crear un registro (incluso sin
    // loguearse, para capturar errores en pantallas públicas), pero nadie
    // puede leerlos, editarlos ni borrarlos desde el cliente — solo se ven
    // desde Firebase Console, que no pasa por estas reglas. Se valida que
    // el mensaje no sea gigante y que la fecha la ponga el servidor, para
    // limitar el abuso de una colección de escritura abierta.
    match /clientErrors/{errorId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() < 500
                    && request.resource.data.createdAt == request.time;
    }
  }
}
